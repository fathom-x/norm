#!/usr/bin/env bash
# norm installer — downloads the right binary from fathom-x/norm GitHub
# releases and puts it on your PATH.
#
# Public repo / release:
#   curl -fsSL https://raw.githubusercontent.com/fathom-x/norm/main/install | bash
#
# While the repo is private, pass a token with repo read access:
#   curl -fsSL -H "Authorization: Bearer $GITHUB_TOKEN" \
#     https://raw.githubusercontent.com/fathom-x/norm/main/install \
#     | GITHUB_TOKEN=$GITHUB_TOKEN bash
set -euo pipefail

APP=norm
REPO=fathom-x/norm

MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
norm installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 0.1.0)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Environment:
    GITHUB_TOKEN / GH_TOKEN Token used for API + asset downloads (required
                            while the repository is private)
    VERSION                 Same as --version

Examples:
    curl -fsSL https://raw.githubusercontent.com/fathom-x/norm/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/fathom-x/norm/main/install | bash -s -- --version 0.1.0
    ./install --binary /path/to/norm
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""
token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${MUTED}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.norm/bin
mkdir -p "$INSTALL_DIR"

print_message() {
    local level=$1
    local message=$2
    local color="${NC}"
    [ "$level" = "error" ] && color="${RED}"
    echo -e "${color}${message}${NC}"
}

api() {
    # Authenticated when a token is available; anonymous otherwise.
    if [ -n "$token" ]; then
        curl -fsSL -H "Authorization: Bearer $token" -H "X-GitHub-Api-Version: 2022-11-28" "$@"
    else
        curl -fsSL "$@"
    fi
}

if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    print_message info "\n${MUTED}Installing ${NC}$APP ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/$APP"
    chmod 755 "${INSTALL_DIR}/$APP"
    specific_version="local"
else
    # --- platform detection (mirrors the release matrix built by
    # --- packages/opencode/script/build.ts) -------------------------------
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    [[ "$arch" == "aarch64" ]] && arch="arm64"
    [[ "$arch" == "x86_64" ]] && arch="x64"

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      [ "$rosetta_flag" = "1" ] && arch="arm64"
    fi

    case "$os-$arch" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64) ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    [ "$os" = "linux" ] && archive_ext=".tar.gz"

    is_musl=false
    if [ "$os" = "linux" ]; then
      [ -f /etc/alpine-release ] && is_musl=true
      if command -v ldd >/dev/null 2>&1; then
        ldd --version 2>&1 | grep -qi musl && is_musl=true
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        grep -qwi avx2 /proc/cpuinfo 2>/dev/null || needs_baseline=true
      fi
      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        [ "$avx2" != "1" ] && needs_baseline=true
      fi
    fi

    target="$os-$arch"
    [ "$needs_baseline" = "true" ] && target="$target-baseline"
    [ "$is_musl" = "true" ] && target="$target-musl"

    filename="$APP-$target$archive_ext"

    if [ "$os" = "linux" ]; then
        command -v tar >/dev/null 2>&1 || { echo -e "${RED}Error: 'tar' is required but not installed.${NC}"; exit 1; }
    else
        command -v unzip >/dev/null 2>&1 || { echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"; exit 1; }
    fi

    # --- resolve release ---------------------------------------------------
    if [ -z "$requested_version" ]; then
        # `releases/latest` is unusable here: owallet-v* releases share this
        # repo, and whichever release published most recently wins "latest".
        # List releases (newest first) and take the newest bare v* norm tag.
        releases=$(api "https://api.github.com/repos/$REPO/releases?per_page=100") || {
            echo -e "${RED}Failed to fetch releases from $REPO${NC}"
            [ -z "$token" ] && echo -e "${MUTED}If the repository is private, set GITHUB_TOKEN.${NC}"
            exit 1
        }
        latest_tag=$(echo "$releases" | tr ',' '\n' | sed -n 's/.*"tag_name": *"\(v[0-9][^"]*\)".*/\1/p' | head -1)
        if [ -z "$latest_tag" ]; then
            echo -e "${RED}No norm release found in $REPO${NC}"
            exit 1
        fi
        release_json=$(api "https://api.github.com/repos/$REPO/releases/tags/$latest_tag") || {
            echo -e "${RED}Failed to fetch release $latest_tag from $REPO${NC}"
            exit 1
        }
    else
        requested_version="${requested_version#v}"
        release_json=$(api "https://api.github.com/repos/$REPO/releases/tags/v${requested_version}") || {
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/$REPO/releases${NC}"
            exit 1
        }
    fi
    specific_version=$(echo "$release_json" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' | head -1)
    if [ -z "$specific_version" ]; then
        echo -e "${RED}Failed to parse release information${NC}"
        exit 1
    fi

    # Asset id for this platform's archive (needed for authenticated download).
    asset_id=$(echo "$release_json" | tr ',' '\n' | grep -B 100 "\"name\": *\"$filename\"" | sed -n 's/.*"id": *\([0-9][0-9]*\).*/\1/p' | tail -1)

    tmp_dir="${TMPDIR:-/tmp}/norm_install_$$"
    mkdir -p "$tmp_dir"
    trap 'rm -rf "$tmp_dir"' EXIT

    # --- skip when already current ------------------------------------------
    # Only skips the norm binary itself: the owallet step below must still
    # run — e.g. a first-run "bundled" choice recorded after norm was already
    # current means owallet gets fetched on a re-run that updates nothing else.
    norm_current=""
    if command -v "$APP" >/dev/null 2>&1; then
        installed_version=$("$APP" --version 2>/dev/null || echo "")
        if [[ "$installed_version" == "$specific_version" ]]; then
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed${NC}"
            norm_current=1
        elif [ -n "$installed_version" ]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version"
        fi
    fi

    # --- download + install --------------------------------------------------
    if [ -z "$norm_current" ]; then
        print_message info "\n${MUTED}Installing ${NC}$APP ${MUTED}version: ${NC}$specific_version ${MUTED}($target)${NC}"

        if [ -n "$token" ] && [ -n "$asset_id" ]; then
            # Private repo: assets must be fetched through the API.
            curl -fL -# -H "Authorization: Bearer $token" -H "Accept: application/octet-stream" \
                -o "$tmp_dir/$filename" \
                "https://api.github.com/repos/$REPO/releases/assets/$asset_id"
        else
            curl -fL -# -o "$tmp_dir/$filename" \
                "https://github.com/$REPO/releases/download/v${specific_version}/$filename"
        fi

        if [ "$os" = "linux" ]; then
            tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
        else
            unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
        fi

        mv "$tmp_dir/$APP" "$INSTALL_DIR/"
        chmod 755 "${INSTALL_DIR}/$APP"
    fi

    # --- owallet (best-effort) ---------------------------------------------
    # norm is built around a local owallet; pull the matching binary from the
    # newest owallet-v* release so a fresh machine gets both in one command.
    # Any failure here is a warning, not an install failure.
    install_owallet() {
        if command -v owallet >/dev/null 2>&1; then
            case "$(command -v owallet)" in
                "$INSTALL_DIR"/*) ;; # ours — refresh below
                *)
                    # norm's first-run prompt records which owallet to use; a
                    # "bundled" choice means install ours even though another
                    # owallet exists on PATH.
                    choice_file="${XDG_DATA_HOME:-$HOME/.local/share}/norm/owallet-binary.json"
                    if ! grep -q '"bundled"' "$choice_file" 2>/dev/null; then
                        print_message info "${MUTED}owallet already installed elsewhere; leaving it alone${NC}"
                        return 0
                    fi
                    ;;
            esac
        fi

        local rust_target archive
        case "$os-$arch" in
            darwin-arm64) rust_target="aarch64-apple-darwin"; archive="tar.gz" ;;
            darwin-x64)   rust_target="x86_64-apple-darwin"; archive="tar.gz" ;;
            linux-x64)    rust_target="x86_64-unknown-linux-musl"; archive="tar.gz" ;;
            linux-arm64)  rust_target="aarch64-unknown-linux-musl"; archive="tar.gz" ;;
            windows-x64)  rust_target="x86_64-pc-windows-msvc"; archive="zip" ;;
            *) return 0 ;;
        esac

        local releases owallet_tag owallet_ver
        releases=$(api "https://api.github.com/repos/$REPO/releases?per_page=100") || {
            print_message info "${MUTED}Could not list releases for owallet; skipping${NC}"
            return 0
        }
        # tr first: the API returns one long line, and a greedy sed over it
        # would match the LAST (oldest) owallet tag instead of the newest.
        owallet_tag=$(echo "$releases" | tr ',' '\n' | sed -n 's/.*"tag_name": *"\(owallet-v[^"]*\)".*/\1/p' | head -1)
        if [ -z "$owallet_tag" ]; then
            print_message info "${MUTED}No owallet release yet; install it separately when one exists${NC}"
            return 0
        fi
        owallet_ver="${owallet_tag#owallet-v}"

        # Skip the ~60MB download when ours is already current.
        if [ -x "$INSTALL_DIR/owallet" ]; then
            installed_owallet=$("$INSTALL_DIR/owallet" --version 2>/dev/null | awk '{print $2}')
            if [ "$installed_owallet" = "$owallet_ver" ]; then
                print_message info "${MUTED}owallet ${NC}$owallet_ver${MUTED} already installed${NC}"
                return 0
            fi
        fi

        local owallet_json owallet_file owallet_asset_id stage
        owallet_json=$(api "https://api.github.com/repos/$REPO/releases/tags/$owallet_tag") || return 0
        owallet_file="owallet-${owallet_ver}-${rust_target}.${archive}"
        owallet_asset_id=$(echo "$owallet_json" | tr ',' '\n' | grep -B 100 "\"name\": *\"$owallet_file\"" | sed -n 's/.*"id": *\([0-9][0-9]*\).*/\1/p' | tail -1)

        print_message info "${MUTED}Installing ${NC}owallet ${MUTED}version: ${NC}$owallet_ver ${MUTED}($rust_target)${NC}"
        if [ -n "$token" ] && [ -n "$owallet_asset_id" ]; then
            curl -fL -# -H "Authorization: Bearer $token" -H "Accept: application/octet-stream" \
                -o "$tmp_dir/$owallet_file" \
                "https://api.github.com/repos/$REPO/releases/assets/$owallet_asset_id" || return 0
        else
            curl -fL -# -o "$tmp_dir/$owallet_file" \
                "https://github.com/$REPO/releases/download/$owallet_tag/$owallet_file" || return 0
        fi

        stage="owallet-${owallet_ver}-${rust_target}"
        if [ "$archive" = "tar.gz" ]; then
            tar -xzf "$tmp_dir/$owallet_file" -C "$tmp_dir" || return 0
            mv "$tmp_dir/$stage/owallet" "$INSTALL_DIR/" || return 0
        else
            unzip -q "$tmp_dir/$owallet_file" -d "$tmp_dir" || return 0
            mv "$tmp_dir/$stage/owallet.exe" "$INSTALL_DIR/" || return 0
        fi
        chmod 755 "$INSTALL_DIR"/owallet* 2>/dev/null || true
    }
    install_owallet
fi

# --- PATH setup ---------------------------------------------------------------
add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file" 2>/dev/null; then
        print_message info "${MUTED}PATH entry already present in ${NC}$config_file"
    elif [[ -w $config_file ]]; then
        echo -e "\n# norm" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Added ${NC}$APP ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "${SHELL:-bash}")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash|sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        if [ "$current_shell" = "fish" ]; then
            add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
        else
            add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
        fi
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

GREEN='\033[0;32m'
echo ""
printf "${GREEN}"
cat <<'MASCOT'
      /\       /\       /\
     /  \▁▁▁▁▁/  \▁▁▁▁▁/  \
 |\  |                    |  /|
 | >-|   .--.      .--.   |-< |
 |/  |  ( () )    ( () )  |  \|
     |   '--'      '--'   |
 |\  | ▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ |  /|
 | >-|    \/        \/    |-< |
 |/   \                  /   \|
       \▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁/
  (oo)    |▄|      |▄|    (oo)
MASCOT
printf "${NC}"
echo ""
echo -e "${MUTED}norm comes preconfigured for the Overpay marketplace via owallet. To start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "norm          ${MUTED}# Run command${NC}"
echo -e ""
