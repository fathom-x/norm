#!/bin/sh
# Serve a fake owallet for the NORM_HOME sandbox: scripted model, real-shaped
# spend accounting and budget refusals, no wallet or Overpay link needed and no
# money spent. See packages/opencode/script/fake-owallet.ts and the norm-test
# skill. Options: --charge-cents N (default 1), --daily-budget USD|off (default 10).
root=$(cd "$(dirname "$0")/.." && pwd)
exec bun --conditions=browser "$root/packages/opencode/script/fake-owallet.ts" "$@"
