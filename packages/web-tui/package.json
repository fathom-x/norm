{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/web-tui",
  "version": "1.18.18",
  "description": "norm in the browser: the opencode core in a Web Worker",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --conditions=browser --preload ./happydom.ts ./src ./test/unit",
    "test:browser": "bun run build && node ./test/browser/smoke.mjs",
    "build:owallet": "./scripts/build-owallet-web.sh",
    "test:owallet": "bun run build:owallet && bun run build && node ./test/browser/owallet.mjs",
    "test:tui": "bun run build && node ./test/browser/tui.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/path-browserify": "1.0.3",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@opencode-ai/core": "workspace:*",
    "@opencode-ai/effect-drizzle-sqlite": "workspace:*",
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/schema": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@opencode-ai/tui": "workspace:*",
    "@opentui/keymap": "catalog:",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@zenfs/core": "2.7.6",
    "@zenfs/dom": "1.2.14",
    "buffer": "6.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "entities": "7.0.1",
    "events": "3.3.0",
    "kerium": "1.5.0",
    "opencode": "workspace:*",
    "path-browserify": "1.0.1",
    "readable-stream": "4.7.0",
    "solid-js": "catalog:",
    "string-width": "7.2.0",
    "utilium": "3.9.0"
  }
}
