+++ b/packages/core/src/zig/build.zig
@@ -40,6 +40,19 @@ const YOGA_CXX_FLAGS = [_][]const u8{
     "-frtti",
 };
 
+// wasm32-wasi has no C++ exception runtime; yoga only throws from its fatal
+// assert path, which aborts instead when exceptions are off.
+const YOGA_CXX_FLAGS_WASM = [_][]const u8{
+    "-std=c++20",
+    "-fno-exceptions",
+    "-fno-rtti",
+};
+
+// Linear memory for the wasm build. Initial == max so memory.grow never runs:
+// JS keeps long-lived typed-array views over native buffers, and growing the
+// memory would detach every one of them.
+const WASM_DEFAULT_MEMORY_MB: u64 = 256;
+
 const YOGA_CXX_SOURCES = [_][]const u8{
     "yoga/YGConfig.cpp",
     "yoga/YGEnums.cpp",
@@ -199,14 +212,57 @@ fn addNativeAudioDependencies(
 
 fn addYogaDependencies(b: *std.Build, artifact: *std.Build.Step.Compile) void {
     const yoga_dep = b.dependency("yoga", .{});
+    const is_wasm = artifact.rootModuleTarget().cpu.arch.isWasm();
 
     artifact.linkLibCpp();
     artifact.addIncludePath(yoga_dep.path(""));
     artifact.addCSourceFiles(.{
         .root = yoga_dep.path(""),
         .files = &YOGA_CXX_SOURCES,
-        .flags = &YOGA_CXX_FLAGS,
+        .flags = if (is_wasm) &YOGA_CXX_FLAGS_WASM else &YOGA_CXX_FLAGS,
+    });
+}
+
+/// Build the core as a wasm32-wasi reactor module: no audio (miniaudio needs
+/// threads and OS audio APIs), single-threaded, every `export fn` kept, the
+/// function table exported so JS callbacks can be installed into it, and a
+/// fixed-size memory.
+fn buildWasmTarget(
+    b: *std.Build,
+    optimize: std.builtin.OptimizeMode,
+    build_options: *std.Build.Step.Options,
+) !void {
+    const memory_mb = b.option(u64, "wasm-memory-mb", "Fixed linear memory size for the wasm build (MiB)") orelse WASM_DEFAULT_MEMORY_MB;
+    const target = b.resolveTargetQuery(try std.Target.Query.parse(.{ .arch_os_abi = "wasm32-wasi" }));
+
+    const module = b.createModule(.{
+        .root_source_file = b.path(ROOT_SOURCE_FILE),
+        .target = target,
+        .optimize = optimize,
+        .single_threaded = true,
+    });
+    applyDependencies(b, module, optimize, target, build_options);
+
+    const exe = b.addExecutable(.{
+        .name = LIB_NAME,
+        .root_module = module,
     });
+    exe.entry = .disabled;
+    exe.rdynamic = true;
+    exe.wasi_exec_model = .reactor;
+    exe.export_table = true;
+    exe.initial_memory = memory_mb * 1024 * 1024;
+    exe.max_memory = memory_mb * 1024 * 1024;
+    exe.stack_size = 1024 * 1024;
+
+    addYogaDependencies(b, exe);
+
+    const install = b.addInstallArtifact(exe, .{
+        .dest_dir = .{ .override = .{ .custom = "../lib/wasm32-wasi" } },
+    });
+    const step = b.step("build-wasm32-wasi", "Build the wasm32-wasi core");
+    step.dependOn(&install.step);
+    b.getInstallStep().dependOn(&install.step);
 }
 
 /// Apply dependencies to a module
@@ -280,7 +336,13 @@ pub fn build(b: *std.Build) void {
     const build_options = b.addOptions();
     build_options.addOption(bool, "gpa_safe_stats", gpa_safe_stats);
 
-    if (target_option) |target_str| {
+    if (target_option != null and std.mem.startsWith(u8, target_option.?, "wasm32")) {
+        buildWasmTarget(b, optimize, build_options) catch |err| {
+            std.debug.print("Error building wasm target: {}\n", .{err});
+            std.process.exit(1);
+        };
+        return;
+    } else if (target_option) |target_str| {
         // Build single target
         buildSingleTarget(b, target_str, optimize, build_options, macos_sdk_path) catch |err| {
             std.debug.print("Error building target '{s}': {}\n", .{ target_str, err });
diff --git a/packages/core/src/zig/lib.zig b/packages/core/src/zig/lib.zig
index b3a2861c..a279250a 100644
--- a/packages/core/src/zig/lib.zig
+++ b/packages/core/src/zig/lib.zig
@@ -1,4 +1,5 @@
 const std = @import("std");
+const builtin = @import("builtin");
 const build_options = @import("build_options");
 const Allocator = std.mem.Allocator;
 
@@ -18,7 +19,38 @@ const utf8 = @import("utf8.zig");
 const logger = @import("logger.zig");
 const event_bus = @import("event-bus.zig");
 const native_span_feed = @import("native-span-feed.zig");
-const native_audio = @import("audio.zig");
+const is_wasm = builtin.target.cpu.arch.isWasm();
+// miniaudio needs OS audio backends and threads; wasm builds get a stub that
+// reports no device.
+const native_audio = if (is_wasm) @import("audio-stub.zig") else @import("audio.zig");
+
+// std.heap.page_allocator on wasm grows linear memory page by page. The wasm
+// build runs with a fixed-size memory (initial == max) so JS-held typed-array
+// views over native buffers are never detached; route page allocations
+// through libc malloc, which carves the preallocated heap instead.
+pub const os = if (is_wasm) struct {
+    pub const heap = struct {
+        pub const page_allocator = std.heap.c_allocator;
+    };
+} else struct {};
+
+// Scratch allocation for the JS wasm FFI backend: buffers JS passes by
+// pointer are staged in linear memory through these.
+fn wasmAlloc(len: u32) callconv(.c) ?[*]u8 {
+    const p = std.c.malloc(@max(len, 1)) orelse return null;
+    return @ptrCast(p);
+}
+
+fn wasmFree(p: ?[*]u8) callconv(.c) void {
+    std.c.free(p);
+}
+
+comptime {
+    if (is_wasm) {
+        @export(&wasmAlloc, .{ .name = "opentuiWasmAlloc" });
+        @export(&wasmFree, .{ .name = "opentuiWasmFree" });
+    }
+}
 const native_renderable = @import("native-renderable.zig");
 const buffer_effects = @import("buffer-methods.zig");
 const handles = @import("handles.zig");
@@ -895,9 +927,9 @@ pub const ExternalCapabilities = extern struct {
     remote: bool,
     multiplexer: u8,
     term_name_ptr: [*]const u8,
-    term_name_len: usize,
+    term_name_len: u64, // u64 to match the JS struct on 32-bit targets
     term_version_ptr: [*]const u8,
-    term_version_len: usize,
+    term_version_len: u64,
     term_from_xtversion: bool,
     osc52_support: u8,
 };
