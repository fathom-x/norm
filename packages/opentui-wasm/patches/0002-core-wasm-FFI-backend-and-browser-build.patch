--- /dev/null
+++ b/packages/core/src/platform/ffi-wasm.ts
@@ -0,0 +1,799 @@
+// WebAssembly FFI backend.
+//
+// The native core can be built for wasm32-wasi (`zig build -Dtarget=wasm32-wasi`,
+// see build.zig). This module turns an instance of that build into the same
+// `dlopen`/`ptr`/`toArrayBuffer` surface the Bun and Node backends expose, so
+// every call site in zig.ts keeps working unchanged. It has no Node or Bun
+// imports: browsers load it as-is, and Bun uses it when OPENTUI_BACKEND=wasm.
+//
+// Semantics that differ from Bun's zero-copy FFI:
+//
+// - `ptr(jsBuffer)` copies the bytes into linear memory and returns that
+//   address. After every native call, regions passed directly as arguments are
+//   copied back into their JS buffers, so out-parameters work. Regions stay
+//   valid until the current synchronous turn ends (they are released on a
+//   microtask once no native call is on the stack), so a pointer taken before
+//   one call and used in the next still works.
+// - `ptr(view)` of a view over the wasm memory itself returns its address
+//   without copying.
+// - `toArrayBuffer` returns a copy. Call sites that need a live alias of native
+//   memory use `toNativeView` (see ffi.ts), which aliases on every backend.
+// - The memory is fixed-size (initial == max), so `memory.buffer` never
+//   changes and aliasing views are never detached.
+// - Callbacks become entries in the module's exported function table.
+
+export interface WasmFfiFunction {
+  readonly args?: readonly string[]
+  readonly returns?: string
+}
+
+export interface WasmCallbackInstance {
+  readonly ptr: number | null
+  readonly threadsafe: boolean
+  close(): void
+}
+
+export interface WasmLibrary {
+  symbols: Record<string, (...args: any[]) => any>
+  createCallback(callback: (...args: any[]) => any, definition: WasmFfiFunction): WasmCallbackInstance
+  close(): void
+}
+
+export interface WasmFfiBackend {
+  readonly kind: "wasm"
+  readonly pointerSize: 4
+  readonly memory: WebAssembly.Memory
+  readonly instance: WebAssembly.Instance
+  dlopen(path: unknown, symbols: Record<string, WasmFfiFunction>): WasmLibrary
+  ptr(value: ArrayBufferLike | ArrayBufferView): number
+  suffix: string
+  toArrayBuffer(pointer: number | bigint, offset: number | undefined, length: number): ArrayBuffer
+  toNativeView<T extends ArrayBufferView>(
+    ctor: { new (buffer: ArrayBufferLike, byteOffset: number, length: number): T; BYTES_PER_ELEMENT: number },
+    pointer: number | bigint,
+    byteLength: number,
+  ): T
+}
+
+export interface OpenTUIWasmHost {
+  /** Bytes the core writes to fd 1 (rendered frames, terminal control). */
+  stdout?: (bytes: Uint8Array) => void
+  /** Bytes the core writes to fd 2. Defaults to console.error. */
+  stderr?: (bytes: Uint8Array) => void
+  /** Environment visible to the core through WASI environ_get. */
+  env?: Record<string, string | undefined>
+}
+
+export interface OpenTUIWasmInstance {
+  readonly instance: WebAssembly.Instance
+  readonly memory: WebAssembly.Memory
+  /** Replace where fd 1 / fd 2 output goes (e.g. once xterm.js is ready). */
+  setHost(host: OpenTUIWasmHost): void
+}
+
+const WASI_ESUCCESS = 0
+const WASI_EBADF = 8
+const WASI_EINVAL = 28
+const WASI_ENOSYS = 52
+const WASI_ENOTCAPABLE = 76
+const WASI_ESPIPE = 70
+
+const textEncoder = new TextEncoder()
+const textDecoder = new TextDecoder()
+
+/**
+ * The handful of WASI preview1 calls the core imports. There is no filesystem:
+ * stdout/stderr go to the host callbacks, stdin reads as empty, and everything
+ * path-based fails with ENOTCAPABLE (no preopened directories).
+ */
+function createWasi(getMemory: () => WebAssembly.Memory, hostRef: { current: OpenTUIWasmHost }) {
+  const view = () => new DataView(getMemory().buffer)
+  const bytes = () => new Uint8Array(getMemory().buffer)
+  const envEntries = () =>
+    Object.entries(hostRef.current.env ?? {})
+      .filter(([, value]) => value !== undefined)
+      .map(([key, value]) => textEncoder.encode(`${key}=${value}\0`))
+
+  const writeStd = (fd: number, chunk: Uint8Array) => {
+    const host = hostRef.current
+    if (fd === 1) {
+      if (host.stdout) host.stdout(chunk)
+    } else if (host.stderr) {
+      host.stderr(chunk)
+    } else {
+      console.error(textDecoder.decode(chunk))
+    }
+  }
+
+  return {
+    fd_write(fd: number, iovs: number, iovsLen: number, nwrittenPtr: number): number {
+      if (fd !== 1 && fd !== 2) return WASI_EBADF
+      const dv = view()
+      const mem = bytes()
+      let total = 0
+      const parts: Uint8Array[] = []
+      for (let i = 0; i < iovsLen; i++) {
+        const base = dv.getUint32(iovs + i * 8, true)
+        const len = dv.getUint32(iovs + i * 8 + 4, true)
+        if (len === 0) continue
+        // Copy: the host may hold on to the chunk (xterm.js queues writes).
+        parts.push(mem.slice(base, base + len))
+        total += len
+      }
+      if (parts.length === 1) {
+        writeStd(fd, parts[0]!)
+      } else if (parts.length > 1) {
+        const joined = new Uint8Array(total)
+        let off = 0
+        for (const part of parts) {
+          joined.set(part, off)
+          off += part.length
+        }
+        writeStd(fd, joined)
+      }
+      dv.setUint32(nwrittenPtr, total, true)
+      return WASI_ESUCCESS
+    },
+    fd_pwrite(): number {
+      return WASI_ESPIPE
+    },
+    fd_read(fd: number, _iovs: number, _iovsLen: number, nreadPtr: number): number {
+      if (fd !== 0) return WASI_EBADF
+      view().setUint32(nreadPtr, 0, true)
+      return WASI_ESUCCESS
+    },
+    fd_seek(): number {
+      return WASI_ESPIPE
+    },
+    fd_close(): number {
+      return WASI_ESUCCESS
+    },
+    fd_fdstat_get(fd: number, statPtr: number): number {
+      if (fd > 2) return WASI_EBADF
+      const dv = view()
+      // filetype: character device; flags 0; rights: all.
+      dv.setUint8(statPtr, 2)
+      dv.setUint16(statPtr + 2, 0, true)
+      dv.setBigUint64(statPtr + 8, 0xffffffffffffffffn, true)
+      dv.setBigUint64(statPtr + 16, 0xffffffffffffffffn, true)
+      return WASI_ESUCCESS
+    },
+    fd_filestat_get(fd: number, statPtr: number): number {
+      if (fd > 2) return WASI_EBADF
+      const mem = bytes()
+      mem.fill(0, statPtr, statPtr + 64)
+      new DataView(mem.buffer).setUint8(statPtr + 16, 2)
+      return WASI_ESUCCESS
+    },
+    fd_prestat_get(): number {
+      return WASI_EBADF
+    },
+    fd_prestat_dir_name(): number {
+      return WASI_EBADF
+    },
+    path_open(): number {
+      return WASI_ENOTCAPABLE
+    },
+    path_create_directory(): number {
+      return WASI_ENOTCAPABLE
+    },
+    environ_sizes_get(countPtr: number, sizePtr: number): number {
+      const entries = envEntries()
+      const dv = view()
+      dv.setUint32(countPtr, entries.length, true)
+      dv.setUint32(
+        sizePtr,
+        entries.reduce((sum, entry) => sum + entry.length, 0),
+        true,
+      )
+      return WASI_ESUCCESS
+    },
+    environ_get(environPtr: number, bufPtr: number): number {
+      const dv = view()
+      const mem = bytes()
+      let offset = bufPtr
+      envEntries().forEach((entry, i) => {
+        dv.setUint32(environPtr + i * 4, offset, true)
+        mem.set(entry, offset)
+        offset += entry.length
+      })
+      return WASI_ESUCCESS
+    },
+    args_sizes_get(countPtr: number, sizePtr: number): number {
+      const dv = view()
+      dv.setUint32(countPtr, 0, true)
+      dv.setUint32(sizePtr, 0, true)
+      return WASI_ESUCCESS
+    },
+    args_get(): number {
+      return WASI_ESUCCESS
+    },
+    clock_time_get(clockId: number, _precision: bigint, outPtr: number): number {
+      let ns: bigint
+      if (clockId === 0) {
+        ns = BigInt(Date.now()) * 1_000_000n
+      } else {
+        const now = typeof performance !== "undefined" ? performance.now() : Date.now()
+        ns = BigInt(Math.round(now * 1_000_000))
+      }
+      view().setBigUint64(outPtr, ns, true)
+      return WASI_ESUCCESS
+    },
+    clock_res_get(_clockId: number, outPtr: number): number {
+      view().setBigUint64(outPtr, 1000n, true)
+      return WASI_ESUCCESS
+    },
+    random_get(bufPtr: number, len: number): number {
+      const target = bytes().subarray(bufPtr, bufPtr + len)
+      if (typeof crypto !== "undefined" && crypto.getRandomValues) {
+        for (let off = 0; off < target.length; off += 65536) {
+          crypto.getRandomValues(target.subarray(off, Math.min(off + 65536, target.length)))
+        }
+      } else {
+        for (let i = 0; i < target.length; i++) target[i] = (Math.random() * 256) | 0
+      }
+      return WASI_ESUCCESS
+    },
+    // Only reached by std.Thread.sleep (a cosmetic delay at renderer
+    // shutdown). The main thread cannot block, so report every subscription
+    // as fired immediately.
+    poll_oneoff(inPtr: number, outPtr: number, nsubscriptions: number, neventsPtr: number): number {
+      const dv = view()
+      for (let i = 0; i < nsubscriptions; i++) {
+        const sub = inPtr + i * 48
+        const evt = outPtr + i * 32
+        dv.setBigUint64(evt, dv.getBigUint64(sub, true), true)
+        dv.setUint16(evt + 8, 0, true)
+        dv.setUint8(evt + 10, dv.getUint8(sub + 8))
+      }
+      dv.setUint32(neventsPtr, nsubscriptions, true)
+      return WASI_ESUCCESS
+    },
+    sched_yield(): number {
+      return WASI_ESUCCESS
+    },
+    proc_exit(code: number): never {
+      throw new Error(`opentui wasm core called proc_exit(${code})`)
+    },
+    proc_raise(): number {
+      return WASI_ENOSYS
+    },
+  }
+}
+
+function wasiImportsFor(module: WebAssembly.Module, wasi: Record<string, (...args: any[]) => any>) {
+  const imports: Record<string, Record<string, (...args: any[]) => any>> = {}
+  for (const entry of WebAssembly.Module.imports(module)) {
+    if (entry.kind !== "function") continue
+    const namespace = (imports[entry.module] ??= {})
+    namespace[entry.name] =
+      entry.module === "wasi_snapshot_preview1" && wasi[entry.name]
+        ? wasi[entry.name]!
+        : () => {
+            console.warn(`opentui wasm: unimplemented import ${entry.module}.${entry.name}`)
+            return WASI_ENOSYS
+          }
+  }
+  return imports
+}
+
+function finishInstance(instance: WebAssembly.Instance, hostRef: { current: OpenTUIWasmHost }): OpenTUIWasmInstance {
+  const exports = instance.exports as Record<string, unknown>
+  const memory = exports.memory as WebAssembly.Memory
+  if (typeof exports._initialize === "function") {
+    ;(exports._initialize as () => void)()
+  }
+  return {
+    instance,
+    memory,
+    setHost(host) {
+      hostRef.current = host
+    },
+  }
+}
+
+/** Synchronously instantiate the core (fine in Bun/Node and in workers). */
+export function instantiateOpenTUIWasmSync(
+  source: BufferSource | WebAssembly.Module,
+  host: OpenTUIWasmHost = {},
+): OpenTUIWasmInstance {
+  const module =
+    source instanceof WebAssembly.Module ? source : new WebAssembly.Module(makeFunctionTableGrowable(source))
+  const hostRef = { current: host }
+  let memory: WebAssembly.Memory | null = null
+  const wasi = createWasi(() => memory!, hostRef)
+  const instance = new WebAssembly.Instance(module, wasiImportsFor(module, wasi))
+  memory = instance.exports.memory as WebAssembly.Memory
+  return finishInstance(instance, hostRef)
+}
+
+/** Asynchronously instantiate the core (browsers' main thread). */
+export async function instantiateOpenTUIWasm(
+  source: BufferSource | WebAssembly.Module | Response | Promise<Response>,
+  host: OpenTUIWasmHost = {},
+): Promise<OpenTUIWasmInstance> {
+  let module: WebAssembly.Module
+  if (source instanceof WebAssembly.Module) {
+    module = source
+  } else if (typeof Response !== "undefined" && (source instanceof Response || source instanceof Promise)) {
+    const response = await source
+    module = await WebAssembly.compile(makeFunctionTableGrowable(await response.arrayBuffer()))
+  } else {
+    module = await WebAssembly.compile(makeFunctionTableGrowable(source as BufferSource))
+  }
+  const hostRef = { current: host }
+  let memory: WebAssembly.Memory | null = null
+  const wasi = createWasi(() => memory!, hostRef)
+  const instance = await WebAssembly.instantiate(module, wasiImportsFor(module, wasi))
+  memory = instance.exports.memory as WebAssembly.Memory
+  return finishInstance(instance, hostRef)
+}
+
+// ---------------------------------------------------------------------------
+// Callback trampolines
+
+const WASM_TYPE: Record<string, number> = {
+  i32: 0x7f,
+  i64: 0x7e,
+  f32: 0x7d,
+  f64: 0x7c,
+}
+
