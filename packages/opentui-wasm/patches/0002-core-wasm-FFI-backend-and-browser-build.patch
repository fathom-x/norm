+// Browser replacement for @opentui/core's "#opentui/runtime-assets". The
+// native library is the wasm core the host instantiated before importing
+// @opentui/core, so there is no library path; tree-sitter assets are not
+// bundled in this build (syntax highlighting is off).
+export function resolveDefaultParserAsset(relativePath: string, fallbackPath: URL): Promise<string> {
+  return Promise.resolve(new URL(relativePath, fallbackPath).href)
+}
+
+export function resolveDefaultTreeSitterWorkerPath(fallbackPath: URL): string {
+  return fallbackPath.href
+}
+
+export function resolveTreeSitterWasm(): Promise<string> {
+  return Promise.reject(new Error("tree-sitter is not bundled in the browser build"))
+}
+
+export async function resolveNativeLibraryPath(): Promise<string> {
+  return "opentui.wasm"
+}
